{
  "name": "name-the-game-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "NODE_NO_WARNINGS=1 turbo run build",
    "start": "NODE_NO_WARNINGS=1 turbo run dev",
    "lint": "NODE_NO_WARNINGS=1 turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0"
  }
}